<?xml version="1.0" encoding="UTF-8"?>
<!--
  仓库级 Maven settings（由 .mvn/maven.config 自动加载，无需任何命令行参数，本地 / CI / Docker 一致）

  为什么提交进仓库：
    组织约定（/srv/nexus/README.md）让每台机器用 client-setup.sh 写 ~/.m2/settings.xml；
    但 CI 容器 / Docker 构建 / 任何新克隆都不该依赖"某台机器配过没有"。
    ⇒ 依赖源是仓库的一部分，不在机器上。

  mirrorOf=*,!nexus 的含义：所有远端解析（含插件仓库）都走 Nexus maven-public（group）
    —— 它再聚合 maven-central proxy（上游 = 阿里云 public）+ maven-releases / maven-snapshots。
    公网只作为 Nexus 的上游，本仓不直连 repo.maven.apache.org。
    排除 !nexus 是必须的：Maven 的 mirror 同样作用于 deploy 目标，
    否则 distributionManagement 里 id=nexus 的 maven-releases/snapshots 会被劫持到只读的 group 仓
    （实测表现为 405，2026-09-14）。mirror id 用 nexus-public 与之区分。

  ⚠️ 凭证硬规矩：绝不把账号写进仓库。
    下面 <servers> 用 Maven 的 ${env.*} 插值，仅 mvn deploy 时由 CI 变量注入（NEXUS_USER / NEXUS_PASS）。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <name>内网 Nexus · maven-public（group）</name>
      <url>https://nexus.ts.huntercat.cn/repository/maven-public/</url>
      <mirrorOf>*,!nexus</mirrorOf>
    </mirror>
  </mirrors>

  <!-- 仅 mvn deploy 使用；凭证来自环境变量（CI 变量注入），不落仓库 -->
  <servers>
    <server>
      <id>nexus</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASS}</password>
    </server>
  </servers>

</settings>
